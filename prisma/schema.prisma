generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Nomination {
  id             String   @id @default(cuid())

  rollNo         String
  studentName    String
  className      String   @default("XI")
  gender         String

  schoolName     String
  schoolDistrict String
  schoolVillage  String
  schoolState    String
  schoolPincode  String

  marksXMath        Float?
  marksXScience     Float?
  marksXAggregate   Float?
  marksXIPercent    Float?

  coordinatorName  String
  coordinatorPhone String
  coordinatorEmail String
  studentEmail     String?

  achievements String?
  prizes       String?
  aspiration   String?

  cycle     String   @default("2026")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolState])
  @@index([schoolName, rollNo])
}
