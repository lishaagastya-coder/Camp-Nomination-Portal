ADMIN_PASSWORD="choose-a-strong-password"
SESSION_SECRET="choose-a-long-random-string"

# Leave both of these blank for local development — the app will use a
# local SQLite file at data/nominations.db automatically.
# For production (e.g. on Vercel), create a free database at turso.tech
# and paste its values here / into your host's environment variables.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
